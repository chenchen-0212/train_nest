# ============================================================
# 环境变量模板
# 本文件【提交到仓库】，作为「运行这个项目需要哪些变量」的清单
# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================================
#
# 设计原则：新增任何环境变量，必须同步在这里加一行。
# 这是 Code Review 的检查项 —— 只改代码不加模板，
# 下一个人 clone 下来必然启动失败。

# ---------- 应用 ----------
NODE_ENV=development
APP_NAME=booking-platform
APP_PORT=3000
API_PREFIX=api

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_PRETTY=false

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=booking_platform
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---------- 认证 ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
